# Public OAuth application identifiers only. Never commit client secrets or tokens.
EAGLEEYE_GOOGLE_CLIENT_ID=
EAGLEEYE_ENTRA_CLIENT_ID=
EAGLEEYE_ENTRA_TENANT=common
EAGLEEYE_GITHUB_CLIENT_ID=

# Anthropic Workload Identity Federation. Prefer a rotating token file.
ANTHROPIC_FEDERATION_RULE_ID=
ANTHROPIC_ORGANIZATION_ID=
ANTHROPIC_SERVICE_ACCOUNT_ID=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_IDENTITY_TOKEN_FILE=

# Local-first AI advisor.
EAGLEEYE_AI_PROVIDER=ollama
EAGLEEYE_AI_MODEL=qwen2.5:3b
EAGLEEYE_AI_LIVE=1
# To reuse the locally authenticated Codex account, set provider to codex-agent.
# EAGLEEYE_AI_PROVIDER=codex-agent
EAGLEEYE_CODEX_TRANSPORT=app-server
# Optional exact comma-separated Orbit/Chrome extension origins. Wildcards are rejected.
EAGLEEYE_ALLOWED_EXTENSION_ORIGINS=
EAGLEEYE_CODEX_MODEL=
EAGLEEYE_CODEX_TIMEOUT_SECONDS=120
EAGLEEYE_BROWSER_AI_MODEL=gpt-5.6-terra
EAGLEEYE_BROWSER_AI_TIMEOUT_SECONDS=75
EAGLEEYE_SAMPLE_TARGET=http://127.0.0.1:8766/demo-site/
EAGLEEYE_DEMO_TIMEOUT_SECONDS=15
EAGLEEYE_ENABLE_API_DOCS=0
EAGLEEYE_OLLAMA_URL=http://127.0.0.1:11434
EAGLEEYE_LM_STUDIO_URL=http://127.0.0.1:1234/v1

# Optional Report Hub endpoint. Set only in the local runtime environment.
EAGLEEYE_REPORT_HUB_URL=http://127.0.0.1:8780/reports/health

# Bounded self-repair. The feature flag alone cannot authorize a write:
# exact high-capability model, clean allowlisted Git root, explicit apply,
# fresh one-use evaluator attestation, diff limits, fixed tests and rollback are also required.
EAGLEEYE_SELF_REPAIR_ENABLED=0
