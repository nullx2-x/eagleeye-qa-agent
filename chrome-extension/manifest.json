{
  "manifest_version": 3,
  "name": "EagleEye Browser QA",
  "version": "1.0.0",
  "description": "現在のタブの安全な操作要約からEagleEye QAセッションを作成します。",
  "minimum_chrome_version": "102",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8766/*",
    "http://localhost:8766/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "EagleEye QA",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "EagleEye QAの記録パネルを開く"
    }
  },
  "incognito": "not_allowed"
}
